# Copy to deploy/.env on the VPS: cp .env.production.example .env && chmod 600 .env
# Never commit deploy/.env. Use hex values for secrets (no $, quotes or spaces),
# because compose also reads this file for ${...} interpolation.

# Image tag for rentcar-app, set to the git short SHA on every deploy (see RUNBOOK.md).
APP_TAG=

# Fixed in docker-compose.yml, do not set here:
# NODE_ENV=production, PORT=5005, DB_HOST=postgres, DB_PORT=5432,
# UPLOAD_DIR=/data/uploads, NODE_OPTIONS=--max-old-space-size=384

# Exact origin, https, no trailing slash.
ALLOWED_ORIGINS=https://rentcar.alyxlabs.tech
# One proxy hop (host nginx).
TRUST_PROXY=1

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TABLE=app_session

# Postgres superuser and table owner: POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB on first start,
# used for migrations, restore and backup. The app never gets these two values.
DB_USER=armj
# Generate: openssl rand -hex 32
DB_PASSWORD=
DB_NAME=armj

# App login role created by DB/17 (no DDL). Compose passes these to the app as DB_USER / DB_PASSWORD.
APP_DB_USER=armj_app
# Generate: openssl rand -hex 32 (different from DB_PASSWORD)
APP_DB_PASSWORD=

EMAIL_USER=
EMAIL_PASS=

# Leave unset in production.
# EMAIL_DRY_RUN=
# EMAIL_DRY_RUN_DIR=
