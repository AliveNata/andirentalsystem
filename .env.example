# Required. The server exits on start when PORT is empty.
PORT=5000
# development | production. production turns on the secure cookie and requires ALLOWED_ORIGINS.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=andirental_db

# Email (Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Session (required, at least 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Frontend origins allowed to send writes, comma separated, exact scheme://host[:port],
# no trailing slash. Empty in development means http://localhost:5173,http://localhost:5180.
ALLOWED_ORIGINS=
# Proxy hops in front of the app (1 behind nginx). Empty or 0 = off.
TRUST_PROXY=
# Session table created by "DB/16. create app_session.sql" (optional, defaults to app_session)
# SESSION_TABLE=

# Upload folder (optional, defaults to ./uploads)
# UPLOAD_DIR=

# Email test mode: 1 writes messages to EMAIL_DRY_RUN_DIR instead of sending
# EMAIL_DRY_RUN=1
# EMAIL_DRY_RUN_DIR=
